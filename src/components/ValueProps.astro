---
import { Icon } from "astro-icon/components";

const props = [
  {
    icon: "lucide:shield-check",
    title: "Privacy first",
    body: "No server, no tracking. Every tool runs in your browser — your data never leaves the machine.",
  },
  {
    icon: "lucide:zap",
    title: "Zero friction",
    body: "Open and use. No account, no API keys, no install required for the web app.",
  },
  {
    icon: "lucide:plane",
    title: "Works offline",
    body: "A PWA that keeps working after the first load — on a plane, behind a firewall, anywhere.",
  },
  {
    icon: "lucide:git-fork",
    title: "Free & open source",
    body: "MIT licensed. Each tool is isolated and independently extendable. Fork it, ship your own.",
  },
];
---

<section id="features" class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <h2 class="font-mono text-2xl font-semibold tracking-tight sm:text-3xl">
        Built for speed, privacy, and trust
      </h2>
      <p class="mt-3 text-muted-foreground">
        Everything you need for daily dev work — nothing you don't. No dark patterns, no telemetry.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        props.map((p) => (
          <div class="reveal card-surface rounded-card p-6 transition-colors hover:border-primary/40">
            <div class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-primary/10 text-primary">
              <Icon name={p.icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-4 font-medium">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
