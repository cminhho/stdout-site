---
import { Icon } from "astro-icon/components";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const risks = [
  "Third-party analytics (GA, Mixpanel, Hotjar)",
  "Browser-fingerprinting scripts",
  "CDN compromise & malicious extensions",
  "Payloads logged on someone else's server",
];
---

<section id="privacy" class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="font-mono text-xs uppercase tracking-widest text-primary">Local-first</span>
      <h2 class="mt-3 font-mono text-2xl font-semibold tracking-tight sm:text-3xl">
        Your data never leaves your device
      </h2>
      <p class="mt-3 text-muted-foreground">
        Most "online" formatters paste your JWTs, payloads, and secrets straight into someone else's
        backend. stdout has no backend — processing happens in memory, on your machine.
      </p>
    </div>

    <div class="mt-12 grid items-stretch gap-5 lg:grid-cols-2">
      <div class="reveal card-surface flex flex-col overflow-hidden rounded-card">
        <div class="border-b border-border px-5 py-3">
          <h3 class="flex items-center gap-2 text-sm font-medium text-foreground">
            <Icon name="lucide:triangle-alert" class="h-4 w-4 text-[#febc2e]" />
            The invisible tracking risk
          </h3>
        </div>
        <img
          src={`${base}/diagrams/the_invisible_tracking_risk.png`}
          alt="How typical browser-based online tools can leak and track sensitive data"
          loading="lazy"
          class="w-full bg-card object-contain"
        />
        <ul class="space-y-2 border-t border-border p-5 text-sm text-muted-foreground">
          {
            risks.map((r) => (
              <li class="flex items-start gap-2">
                <Icon name="lucide:x" class="mt-0.5 h-4 w-4 shrink-0 text-[#ff5f57]" />
                {r}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal card-surface flex flex-col overflow-hidden rounded-card">
        <div class="border-b border-border px-5 py-3">
          <h3 class="flex items-center gap-2 text-sm font-medium text-foreground">
            <Icon name="lucide:shield-check" class="h-4 w-4 text-primary" />
            How stdout works
          </h3>
        </div>
        <img
          src={`${base}/diagrams/stdout_architecture.png`}
          alt="stdout client-only architecture: tools run in the browser or desktop with no backend"
          loading="lazy"
          class="w-full bg-card object-contain"
        />
        <ul class="space-y-2 border-t border-border p-5 text-sm text-muted-foreground">
          <li class="flex items-start gap-2"><Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />Client-only processing — no backend</li>
          <li class="flex items-start gap-2"><Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />Runs in the browser or as a desktop app</li>
          <li class="flex items-start gap-2"><Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />No network calls, no payload logging</li>
          <li class="flex items-start gap-2"><Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />Works offline after first load</li>
        </ul>
      </div>
    </div>
  </div>
</section>
