---
import { Icon } from "astro-icon/components";
const base = import.meta.env.BASE_URL;

const features = [
  { icon: "lucide:layout-panel-top", title: "Multi-tab workspace", body: "Open several tools at once and switch instantly — open the same tool twice to compare two payloads." },
  { icon: "lucide:list-tree", title: "JSON tree view", body: "Collapse, search keys & values, and copy any node's JSONPath or value." },
  { icon: "lucide:command", title: "Command palette", body: "⌘K / Ctrl+K to jump to any of the 59 tools without leaving the keyboard." },
  { icon: "lucide:moon", title: "Themes", body: "Dark, light, and OLED deep-dark — tuned for long sessions." },
];
---

<section class="border-t border-border/60 py-20 sm:py-28">
  <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="reveal">
        <h2 class="font-mono text-2xl font-semibold tracking-tight sm:text-3xl">
          A workspace, not just a page
        </h2>
        <p class="mt-3 text-muted-foreground">
          stdout works like the editor you already live in — keyboard-driven, tabbed, and fast.
        </p>
        <ul class="mt-8 space-y-5">
          {
            features.map((f) => (
              <li class="flex gap-3.5">
                <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                  <Icon name={f.icon} class="h-4 w-4" />
                </span>
                <div>
                  <h3 class="font-medium">{f.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{f.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal card-surface overflow-hidden rounded-card shadow-2xl">
        <div class="flex items-center gap-2 border-b border-border bg-muted/40 px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
        </div>
        <img
          src={`${base}/screenshots/stdout-overview.png`}
          alt="The stdout app: tool grid with sidebar navigation and command palette"
          loading="lazy"
          class="w-full bg-card object-cover"
        />
      </div>
    </div>
  </div>
</section>
